{
  "rules": {
    ".read": false,
    ".write": false,
    "events": {
      "$eventId": {
        "config": {
          ".read": true,
          "revealAt": {
            ".write": "auth != null && newData.exists() && root.child('events').child($eventId).child('admins').child(auth.uid).val() === true",
            ".validate": "newData.isNumber() && newData.val() > now"
          }
        },
        "admins": {
          ".read": "auth != null && root.child('events').child($eventId).child('admins').child(auth.uid).val() === true",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid !== $uid && root.child('events').child($eventId).child('admins').child(auth.uid).val() === true",
            ".validate": "newData.val() === true && $uid.matches(/^[A-Za-z0-9]{20,40}$/)"
          }
        },
        "adminNames": {
          ".read": "auth != null && root.child('events').child($eventId).child('admins').child(auth.uid).val() === true",
          "$uid": {
            ".write": "auth != null && root.child('events').child($eventId).child('admins').child(auth.uid).val() === true",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
          }
        },
        "texts": {
          ".read": true,
          ".write": "auth != null && root.child('events').child($eventId).child('admins').child(auth.uid).val() === true",
          "$key": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          }
        },
        "guestPhones": {
          ".read": "auth != null && root.child('events').child($eventId).child('admins').child(auth.uid).val() === true",
          "$code": {
            ".write": "auth != null && root.child('events').child($eventId).child('admins').child(auth.uid).val() === true",
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8,15}$/)"
          }
        },
        "private": {
          ".read": "auth != null && root.child('events').child($eventId).child('admins').child(auth.uid).val() === true",
          "$code": {
            ".read": true,
            ".write": "auth != null && root.child('events').child($eventId).child('admins').child(auth.uid).val() === true",
            ".validate": "$code.length >= 8 && $code.length <= 64",
            "guest": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            }
          }
        },
        "voteCount": {
          ".read": true,
          ".write": "auth != null && !data.parent().child('votes').child(auth.uid).exists() && newData.parent().child('votes').child(auth.uid).exists()",
          ".validate": "newData.isNumber() && data.isNumber() && newData.val() === data.val() + 1"
        },
        "voterNames": {
          "$nameKey": {
            ".read": true,
            ".write": "auth != null && !data.exists() && now < root.child('events').child($eventId).child('config').child('revealAt').val()",
            ".validate": "$nameKey.length >= 1 && $nameKey.length <= 60 && newData.val() === auth.uid && newData.parent().parent().child('votes').child(auth.uid).child('nameKey').val() === $nameKey"
          }
        },
        "votes": {
          ".read": "now >= root.child('events').child($eventId).child('config').child('revealAt').val() || (auth != null && root.child('events').child($eventId).child('admins').child(auth.uid).val() === true)",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists() && now < root.child('events').child($eventId).child('config').child('revealAt').val()",
            ".validate": "newData.hasChildren(['name', 'nameKey', 'choice', 'ts']) && newData.child('nameKey').isString() && newData.parent().parent().child('voterNames').child(newData.child('nameKey').val()).val() === auth.uid && newData.parent().parent().child('voteCount').val() === root.child('events').child($eventId).child('voteCount').val() + 1",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "nameKey": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "choice": {
              ".validate": "newData.val() === 'nino' || newData.val() === 'nina'"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "rsvps": {
          ".read": "auth != null && root.child('events').child($eventId).child('admins').child(auth.uid).val() === true",
          "$key": {
            ".read": "auth != null && ($key === auth.uid || root.child('events').child($eventId).child('private').child($key).child('guest').exists())",
            ".write": "auth != null && newData.exists() && ($key === auth.uid || root.child('events').child($eventId).child('private').child($key).child('guest').exists())",
            ".validate": "newData.hasChildren(['name', 'attending', 'guests', 'code', 'ts']) && newData.child('code').isString() && newData.child('code').val().length >= 4 && newData.child('code').val().length <= 64 && root.child('events').child($eventId).child('private').child(newData.child('code').val()).exists() && ($key === auth.uid || newData.child('code').val() === $key)",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "attending": {
              ".validate": "newData.isBoolean()"
            },
            "guests": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
            },
            "message": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "code": {
              ".validate": "newData.isString()"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
